# Copy to .env and fill in only the labs the chosen chain actually uses.
# The CLI refuses to start if any seat in the chosen chain is missing its key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=

# Default per-run spend ceiling in USD. Overridden per run by --max-usd.
# A run stops cleanly before any stage that could take it past this, and
# resumes with a higher ceiling. Unset means $7 for a chain with no paid seat;
# a paid chain asks you to type its limit (this value is only the suggestion).
# --max-usd none works for a chain with no paid seat only.
MAX_USD_PER_RUN=7

# Optional settings (README "Setup" lists them all): COUNCIL_MAX_USD_LIMIT (a ceiling: the MCP server's tools cannot lift it and the limit you type for a paid run, or the total you type for a paid tree (`council tree start --max-usd`, `council tree decide --amend-cap`), cannot go above it), OLLAMA_API_KEY, AUDIT_HMAC_KEY_FILE.
# Three more are NOT read from a .env (the CLI prints a notice and ignores them there): set them in the real environment:
# COUNCIL_WORKDIR, COUNCIL_PERSONAS_FILE and COUNCIL_ALLOW_LOOPBACK_KEY_HOST=1 (for a local proxy in front of a keyed provider).
