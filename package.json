{
  "name": "the-high-council",
  "version": "0.7.6",
  "description": "The High Council: a multi-model planning harness. One builder, independent critics from other labs, checkable acceptance criteria, a debate on the record, and a hard stop.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "council": "src/cli.js"
  },
  "scripts": {
    "run": "node src/cli.js",
    "cost": "node src/cost.js",
    "dry": "node src/cli.js --dry-run",
    "ui": "node src/ui/server.js",
    "mcp": "node src/mcp/server.js",
    "http-server": "node src/http-server.js",
    "test": "node --test",
    "build:bin": "pkg . --compress GZip",
    "build:appimage": "bash scripts/build-appimage.sh",
    "smoke:bin": "node scripts/smoke-binary.mjs"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "src/pricing.json",
      "chains/**/*.json"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.22.2",
    "zod": "^4.6.4"
  },
  "files": [
    "src/",
    "chains/",
    "README.md",
    "TROUBLESHOOTING.md",
    "CONTRIBUTING.md",
    "PERSONAS.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muad-yasin/the-high-council-mcp.git"
  },
  "homepage": "https://sower-industries.de/MCP",
  "bugs": {
    "url": "https://github.com/muad-yasin/the-high-council-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "multi-agent",
    "planning",
    "claude",
    "ai",
    "cli"
  ],
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0"
  }
}
