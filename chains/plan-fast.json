{
  "name": "plan-fast",
  "description": "Sophi-A preset, not a judging chain. Draft + two critics, no revision loop - for a quick sanity pass on a small change, not a design worth five labs' scrutiny. Builder on Sonnet 5; two cheap-tier critics (Qwen, GLM).",
  "maxRounds": 1,
  "stopOnPass": true,
  "estimate": {
    "promptTokens": 16000,
    "draftTokens": 16000,
    "critiqueTokens": 2000
  },
  "seats": {
    "criteria": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "maxTokens": 8000,
      "extra": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "builder": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "maxTokens": 40000,
      "extra": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "reviser": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "maxTokens": 40000,
      "extra": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "critics": [
      {
        "provider": "together",
        "model": "Qwen/Qwen3.5-9B",
        "maxTokens": 20000,
        "extra": {
          "chat_template_kwargs": {
            "enable_thinking": false
          }
        },
        "lab": "qwen"
      },
      {
        "provider": "zai",
        "model": "glm-4.7-flash",
        "maxTokens": 20000,
        "extra": {
          "thinking": {
            "type": "disabled"
          }
        }
      }
    ]
  }
}
