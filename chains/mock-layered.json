{
  "name": "mock-layered",
  "description": "Offline. Exercises the layered review panel (seats.critics[].layer): layer 1 reviews first, layer 2 is asked only when layer 1 signed off, layer 3 only when layer 2 did. The default mock critics fail an unrevised draft and pass the revised one, so round 1 stops at layer 1 (layers 2 and 3 are recorded as not asked), the reviser fixes the draft, and round 2 climbs through all three layers and signs off. The dispute stage is on so a run that does not climb all the way records what is still open.",
  "maxRounds": 3,
  "signoff": "unanimous",
  "dispute": {
    "enabled": true,
    "stall_rounds": 2
  },
  "estimate": {
    "promptTokens": 1000,
    "draftTokens": 1000,
    "critiqueTokens": 300
  },
  "seats": {
    "criteria": {
      "provider": "mock",
      "model": "mock-criteria"
    },
    "builder": {
      "provider": "mock",
      "model": "mock-builder",
      "lab": "mock-author"
    },
    "reviser": {
      "provider": "mock",
      "model": "mock-builder",
      "lab": "mock-author"
    },
    "critics": [
      {
        "provider": "mock",
        "model": "mock-critic-a",
        "lab": "mock-a",
        "layer": 1
      },
      {
        "provider": "mock",
        "model": "mock-critic-b",
        "lab": "mock-b",
        "layer": 1
      },
      {
        "provider": "mock",
        "model": "mock-critic-c",
        "lab": "mock-c",
        "layer": 2
      },
      {
        "provider": "mock",
        "model": "mock-critic-d",
        "lab": "mock-d",
        "layer": 2
      },
      {
        "provider": "mock",
        "model": "mock-critic-e",
        "lab": "mock-e",
        "layer": 3
      },
      {
        "provider": "mock",
        "model": "mock-critic-f",
        "lab": "mock-f",
        "layer": 3
      }
    ]
  }
}
